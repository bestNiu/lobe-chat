# White-label 部署环境变量（UnionclinHub）
#
# 用法：把下面内容合并进 docker-compose 的 `lobe` 服务所读的 env 文件
#       （docker-compose/local/compose.yml → env_file: ${YOULIN_ENV_FILE}）。
# 说明：本文件只列阶段一（P0–P6）用到的变量；未列出的沿用上游默认值。

# ── 功能开关（D13 社区保留 / D14 其余关闭）────────────────────────────────
# market 保持开启。changelog / check_updates 关闭，GitHub 页脚与帮助文档隐藏。
FEATURE_FLAGS="+market,-changelog,-check_updates,+commercial_hide_github,+commercial_hide_docs"

# ── 域名（D15 官网已定；T1b 应用域名待定，上线前必须覆盖 OFFICIAL_URL）────
NEXT_PUBLIC_OFFICIAL_SITE=https://www.unionclin.com
NEXT_PUBLIC_OFFICIAL_DOMAIN=unionclin.com
NEXT_PUBLIC_OFFICIAL_URL=https://www.unionclin.com
# 落地站 sitemap 重定向目标（可选）
NEXT_PUBLIC_LANDING_SITEMAP_URL=https://www.unionclin.com/sitemap.xml

# ── 跳转与邮件（D22）──────────────────────────────────────────────────────
AUTH_APP_HOME=https://www.unionclin.com
# 发件人显示名；配成 LobeHub 会让前面所有邮件模板改动失效
SMTP_FROM="UnionclinHub <noreply@unionclin.com>"

# ── 分析上报：全部关闭（内部部署不外发数据）──────────────────────────────
ENABLED_PLAUSIBLE_ANALYTICS=0
ENABLED_POSTHOG_ANALYTICS=0
ENABLED_UMAMI_ANALYTICS=0
ENABLED_CLARITY_ANALYTICS=0
ENABLE_VERCEL_ANALYTICS=0
ENABLE_GOOGLE_ANALYTICS=0

# ── 阶段二预留（不在阶段一范围，先注释）──────────────────────────────────
# NEXT_PUBLIC_BRAND_PRIMARY=#1685EC
# NEXT_PUBLIC_BRAND_NEUTRAL=slate
# ── 审计第 4 轮补充（缺省会导致回落到 lobehub.com 或 404）────────────────
# 技能安装说明的基地址；不配则回落到 ${OFFICIAL_SITE}/skills/<id>/skill.md
MARKET_SKILL_INSTALL_BASE_URL=https://www.unionclin.com
# OIDC 授权页 client logo；不配则用应用自身相对路径 /brand/mark.png
OIDC_CLIENT_LOGO_URI=https://www.unionclin.com/brand/mark.png
