     4	export interface YoulinModelPrice {
     5	  cachedInputMicroUsdPerMillion: bigint;
     6	  inputMicroUsdPerMillion: bigint;
     7	  outputMicroUsdPerMillion: bigint;
     8	  requestMicroUsd: bigint;
     9	  version: string;
    10	}
    11	
    12	export interface YoulinModelGrant {
    13	  maxInputTokens: number;
    14	  maxOutputTokens: number;
    15	  modelId: string;
    16	  /** Missing price means unavailable, not free. Explicit zero rates are allowed. */
    17	  price?: Readonly<YoulinModelPrice>;
    18	}
    19	
    20	export interface YoulinModelAccessPolicy {
    21	  enabled: boolean;
    22	  enterpriseId: string;
    23	  models: readonly Readonly<YoulinModelGrant>[];
    24	  /** Authoritative user-scoped freeze, surviving calendar rollover. */
    25	  spendingFrozen: boolean;
    26	  userId: string;
    27	}
    28	
    29	export interface YoulinModelBudgetAccount {
    30	  enterpriseId: string;
    31	  frozen: boolean;
    32	  limitMicroUsd: bigint;
    33	  period: string;
    34	  reservedMicroUsd: bigint;
    35	  spentMicroUsd: bigint;
    36	  userId: string;
    37	}
    38	
    39	export interface YoulinModelReservationRequest {
    40	  id: string;
    41	  /** Trusted upper bound including all system/tool/history input, NOT a client estimate. */
    42	  inputTokenBound: number;
    43	  maxOutputTokens: number;
    44	  modelId: string;
    45	  /** Server-generated digest of the effective request, including model, tools and limits. */
    46	  payloadDigest: string;
    47	}
    48	
    49	export interface YoulinModelUsage {
    50	  /** Included in inputTokens, not additional tokens. */
    51	  cachedInputTokens: number;
    52	  inputTokens: number;
    53	  /** Includes all billed output, including reasoning when applicable. */
    54	  outputTokens: number;
    55	}
    56	
    57	export type YoulinModelReservationState =
    58	  'reserved' | 'in_flight' | 'uncertain' | 'settled' | 'cancelled';
    59	
    60	export interface YoulinModelReservation extends YoulinModelReservationRequest {
    61	  chargedMicroUsd?: bigint;
    62	  enterpriseId: string;
    63	  heldMicroUsd: bigint;
    64	  period: string;
    65	  price: Readonly<YoulinModelPrice>;
    66	  state: YoulinModelReservationState;
    67	  usage?: Readonly<YoulinModelUsage>;
    68	  userId: string;
    69	}
