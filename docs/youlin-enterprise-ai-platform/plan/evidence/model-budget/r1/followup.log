    71	export const YOULIN_DEFAULT_MONTHLY_BUDGET_MICRO_USD = 20_000_000n;
     1	import type {
     2	  YoulinModelAccessPolicy,
     3	  YoulinModelBudgetAccount,
     4	  YoulinModelReservation,
     5	  YoulinModelReservationRequest,
     6	} from '@lobechat/types';
     7	
     8	import {
     9	  checkedMoney,
    10	  checkedTokens,
    11	  quoteUpperBound,
    12	  snapshotPrice,
    13	  YoulinModelBudgetError,
    14	} from './money';
    15	import { shanghaiBudgetPeriod } from './period';
    16	
    17	export const validateAccount = (account: Readonly<YoulinModelBudgetAccount>) => {
    18	  if (
    19	    !account.enterpriseId ||
    20	    !account.userId ||
    21	    typeof account.frozen !== 'boolean' ||
    22	    !/^\d{4}-(?:0[1-9]|1[0-2])$/.test(account.period)
    23	  )
    24	    throw new YoulinModelBudgetError('INVALID_ACCOUNT');
    25	  checkedMoney(account.limitMicroUsd);
    26	  checkedMoney(account.reservedMicroUsd);
    27	  checkedMoney(account.spentMicroUsd);
    28	};
    29	
    30	const requireGrant = (
    31	  account: Readonly<YoulinModelBudgetAccount>,
    32	  policy: Readonly<YoulinModelAccessPolicy>,
    33	  request: Readonly<YoulinModelReservationRequest>,
    34	) => {
    35	  validateAccount(account);
    36	  if (
    37	    policy.enterpriseId !== account.enterpriseId ||
    38	    policy.userId !== account.userId ||
    39	    policy.enabled !== true
    40	  )
    41	    throw new YoulinModelBudgetError('MODEL_NOT_ALLOWED');
    42	  if (policy.spendingFrozen !== false) throw new YoulinModelBudgetError('BUDGET_FROZEN');
    43	  const grants = policy.models.filter((grant) => grant.modelId === request.modelId);
    44	  if (grants.length !== 1) throw new YoulinModelBudgetError('MODEL_NOT_ALLOWED');
    45	  const grant = grants[0];
    46	  checkedTokens(grant.maxInputTokens);
    47	  checkedTokens(grant.maxOutputTokens);
    48	  checkedTokens(request.inputTokenBound);
    49	  checkedTokens(request.maxOutputTokens);
    50	  if (
    51	    !request.modelId ||
    52	    !request.id ||
    53	    request.id.length > 128 ||
    54	    !/^[a-f0-9]{64}$/.test(request.payloadDigest) ||
    55	    request.maxOutputTokens === 0 ||
    56	    request.inputTokenBound > grant.maxInputTokens ||
    57	    request.maxOutputTokens > grant.maxOutputTokens
    58	  )
    59	    throw new YoulinModelBudgetError('INVALID_REQUEST');
    60	  if (!grant.price) throw new YoulinModelBudgetError('PRICE_NOT_CONFIGURED');
    61	  return snapshotPrice(grant.price);
    62	};
    63	
    64	export const assertReservationScope = (
    65	  account: Readonly<YoulinModelBudgetAccount>,
    66	  reservation: Readonly<YoulinModelReservation>,
    67	) => {
    68	  validateAccount(account);
    69	  if (
    70	    account.enterpriseId !== reservation.enterpriseId ||
    71	    account.userId !== reservation.userId ||
    72	    account.period !== reservation.period
    73	  )
    74	    throw new YoulinModelBudgetError('RESERVATION_SCOPE_MISMATCH');
    75	  checkedMoney(reservation.heldMicroUsd);
    76	};
    77	
    78	/** Pure reducer only. Caller MUST lock policy/account/reservation and persist atomically.
    79	 * A replay is a receipt, NEVER permission to send a second upstream request.
    80	 */
    81	export const reserveModelBudget = (
    82	  account: Readonly<YoulinModelBudgetAccount>,
    83	  policy: Readonly<YoulinModelAccessPolicy>,
    84	  request: Readonly<YoulinModelReservationRequest>,
    85	  now: Date,
    86	  existing?: Readonly<YoulinModelReservation>,
    87	) => {
    88	  const price = requireGrant(account, policy, request);
    89	  if (existing) {
    90	    if (
    91	      existing.enterpriseId !== account.enterpriseId ||
    92	      existing.userId !== account.userId ||
    93	      existing.id !== request.id ||
    94	      existing.payloadDigest !== request.payloadDigest ||
    95	      existing.modelId !== request.modelId ||
    96	      existing.inputTokenBound !== request.inputTokenBound ||
    97	      existing.maxOutputTokens !== request.maxOutputTokens
    98	    )
    99	      throw new YoulinModelBudgetError('IDEMPOTENCY_CONFLICT');
   100	    return { account, created: false, reservation: existing };
   101	  }
   102	  if (account.period !== shanghaiBudgetPeriod(now).id)
   103	    throw new YoulinModelBudgetError('PERIOD_MISMATCH');
   104	  if (account.frozen) throw new YoulinModelBudgetError('BUDGET_FROZEN');
   105	  const heldMicroUsd = quoteUpperBound(price, request.inputTokenBound, request.maxOutputTokens);
   106	  if (account.spentMicroUsd + account.reservedMicroUsd + heldMicroUsd > account.limitMicroUsd)
   107	    throw new YoulinModelBudgetError('BUDGET_EXHAUSTED');
   108	  const reservation: YoulinModelReservation = {
   109	    ...request,
   110	    enterpriseId: account.enterpriseId,
   111	    heldMicroUsd,
   112	    period: account.period,
   113	    price,
   114	    state: 'reserved',
   115	    userId: account.userId,
   116	  };
   117	  return {
   118	    account: {
   119	      ...account,
   120	      reservedMicroUsd: checkedMoney(account.reservedMicroUsd + heldMicroUsd),
   121	    },
   122	    created: true,
   123	    reservation,
   124	  };
   125	};
   126	
   127	/** Atomically claim once BEFORE I/O; a crash afterwards remains potentially billable. */
   128	export const beginModelDispatch = (
   129	  account: Readonly<YoulinModelBudgetAccount>,
   130	  policy: Readonly<YoulinModelAccessPolicy>,
   131	  reservation: Readonly<YoulinModelReservation>,
   132	  now: Date,
   133	): YoulinModelReservation => {
   134	  assertReservationScope(account, reservation);
   135	  const currentPrice = requireGrant(account, policy, reservation);
   136	  if (
   137	    currentPrice.version !== reservation.price.version ||
   138	    currentPrice.inputMicroUsdPerMillion !== reservation.price.inputMicroUsdPerMillion ||
   139	    currentPrice.cachedInputMicroUsdPerMillion !==
   140	      reservation.price.cachedInputMicroUsdPerMillion ||
   141	    currentPrice.outputMicroUsdPerMillion !== reservation.price.outputMicroUsdPerMillion ||
   142	    currentPrice.requestMicroUsd !== reservation.price.requestMicroUsd
   143	  )
   144	    throw new YoulinModelBudgetError('PRICE_CHANGED');
   145	  if (reservation.state !== 'reserved')
   146	    throw new YoulinModelBudgetError('DISPATCH_ALREADY_CLAIMED');
   147	  if (account.period !== shanghaiBudgetPeriod(now).id)
   148	    throw new YoulinModelBudgetError('PERIOD_MISMATCH');
   149	  if (account.frozen) throw new YoulinModelBudgetError('BUDGET_FROZEN');
   150	  if (
   151	    account.reservedMicroUsd < reservation.heldMicroUsd ||
   152	    account.spentMicroUsd + account.reservedMicroUsd > account.limitMicroUsd
   153	  )
   154	    throw new YoulinModelBudgetError('BUDGET_EXHAUSTED');
   155	  return { ...reservation, state: 'in_flight' };
   156	};
     1	import type {
     2	  YoulinModelBudgetAccount,
     3	  YoulinModelReservation,
     4	  YoulinModelUsage,
     5	} from '@lobechat/types';
     6	
     7	import { checkedMoney, priceUsage, YoulinModelBudgetError } from './money';
     8	import { assertReservationScope } from './reservation';
     9	
    10	/** Only pre-dispatch cancellation is safely free. Never use TTL/client abort as proof. */
    11	export const cancelUnsentReservation = (
    12	  account: Readonly<YoulinModelBudgetAccount>,
    13	  reservation: Readonly<YoulinModelReservation>,
    14	) => {
    15	  assertReservationScope(account, reservation);
    16	  if (reservation.state === 'cancelled') return { account, reservation };
    17	  if (reservation.state !== 'reserved') throw new YoulinModelBudgetError('POTENTIALLY_BILLABLE');
    18	  if (account.reservedMicroUsd < reservation.heldMicroUsd)
    19	    throw new YoulinModelBudgetError('INVALID_ACCOUNT');
    20	  return {
    21	    account: { ...account, reservedMicroUsd: account.reservedMicroUsd - reservation.heldMicroUsd },
    22	    reservation: { ...reservation, state: 'cancelled' as const },
    23	  };
    24	};
    25	
    26	export const markUsageUncertain = (
    27	  reservation: Readonly<YoulinModelReservation>,
    28	): YoulinModelReservation => {
    29	  if (reservation.state !== 'in_flight' && reservation.state !== 'uncertain')
    30	    throw new YoulinModelBudgetError('INVALID_RESERVATION_STATE');
    31	  // No release or retry grant. The reservation stays in its ORIGINAL month's account.
    32	  return { ...reservation, state: 'uncertain' };
    33	};
    34	
    35	/** Trusted FINAL gateway usage only, not partial streamed counters or browser reports.
    36	 * Snapshot pricing survives policy changes. A genuine overrun is recorded and freezes
    37	 * further spending; it is never silently clamped/discarded to make the budget look good.
    38	 */
    39	export const settleModelUsage = (
    40	  account: Readonly<YoulinModelBudgetAccount>,
    41	  reservation: Readonly<YoulinModelReservation>,
    42	  usage: Readonly<YoulinModelUsage>,
    43	) => {
    44	  assertReservationScope(account, reservation);
    45	  const chargedMicroUsd = priceUsage(reservation.price, usage);
    46	  if (reservation.state === 'settled') {
    47	    if (
    48	      !reservation.usage ||
    49	      reservation.chargedMicroUsd !== chargedMicroUsd ||
    50	      reservation.usage.inputTokens !== usage.inputTokens ||
    51	      reservation.usage.cachedInputTokens !== usage.cachedInputTokens ||
    52	      reservation.usage.outputTokens !== usage.outputTokens
    53	    )
    54	      throw new YoulinModelBudgetError('SETTLEMENT_CONFLICT');
    55	    return { account, freezeUser: null, reservation, settled: false };
    56	  }
    57	  if (reservation.state !== 'in_flight' && reservation.state !== 'uncertain')
    58	    throw new YoulinModelBudgetError('INVALID_RESERVATION_STATE');
    59	  if (account.reservedMicroUsd < reservation.heldMicroUsd)
    60	    throw new YoulinModelBudgetError('INVALID_ACCOUNT');
    61	  const reservedMicroUsd = account.reservedMicroUsd - reservation.heldMicroUsd;
    62	  const spentMicroUsd = checkedMoney(account.spentMicroUsd + chargedMicroUsd);
    63	  const overrun =
    64	    chargedMicroUsd > reservation.heldMicroUsd ||
    65	    usage.inputTokens > reservation.inputTokenBound ||
    66	    usage.outputTokens > reservation.maxOutputTokens;
    67	  const freeze =
    68	    account.frozen || overrun || spentMicroUsd + reservedMicroUsd > account.limitMicroUsd;
    69	  return {
    70	    // MUST apply to the user-scoped policy in the SAME transaction as this settlement.
    71	    // null means no new freeze action; it NEVER means unfreeze.
    72	    freezeUser: freeze ? { enterpriseId: account.enterpriseId, userId: account.userId } : null,
    73	    account: {
    74	      ...account,
    75	      frozen: freeze,
    76	      reservedMicroUsd,
    77	      spentMicroUsd,
    78	    },
    79	    reservation: {
    80	      ...reservation,
    81	      chargedMicroUsd,
    82	      state: 'settled' as const,
    83	      usage: Object.freeze({ ...usage }),
    84	    },
    85	    settled: true,
    86	  };
    87	};
     1	# Youlin single-key model budget domain
     2	
     3	This directory contains **pure server-side policy reducers**, not a live billing service. Nothing registers them on the existing Chat endpoints. There is no in-memory production balance, database adapter, admin API/UI or claim of multi-process enforcement yet. Do not enable shared-key employee traffic on the strength of these tests.
     4	
     5	## Implemented rules
     6	
     7	- USD20 is the user-confirmed **initial/default** monthly allowance, not an immutable maximum: administrators may adjust per-user budgets. Only a future authorized persistence layer supplies `limitMicroUsd`; never accept it from a chat request. The exported default constant is intended for account creation, not a clamp on administrative adjustments.
     8	- Exact integer USD millionths; tariff rates are micro-USD per million tokens, plus an explicit per-request charge. `20 USD = 20_000_000` micro-USD. No float arithmetic, scientific notation or implicit free fallback.
     9	- Exact tenant/user/model grant match, current enabled policy, unique model entry, configured price and bounded input/output. Prices are trusted administrator-authored local tariffs, not values provided by the browser or inferred from model names.
    10	- Reserve the worst supported text-token charge before I/O, including cache-premium pricing. An input bound must cover system prompts, history, tools and overhead; do NOT trust the client's token estimate. Images/audio/video/search/tool fees require their own verified meter before use.
    11	- Reserve → claim dispatch once → final settle, or retain uncertain usage. Only a reservation never claimed for dispatch can be cancelled as free. Timeout, stream disconnect, 5xx, lost final usage or a crashed worker do not prove no upstream charge.
    12	- Recheck permission, account freeze, policy limits, month and unchanged price before dispatch. Current permission denial also blocks idempotency replay. A returned historical receipt is not a second upstream-call permit.
    13	- Settle with the immutable dispatch quote, trusted final usage including billed reasoning, and cached input as a subset of input. Round once per request by less than one micro-dollar. Record overruns and freeze further spending rather than truncating charges.
    14	- Periods are Asia/Shanghai calendar months (contemporary +08), not rolling 30 days. Old in-flight requests settle in their original period; never move their unresolved holds into or erase them on the next month.
    15	
    16	## Required persistence / transport contract (NOT implemented here)
    17	
    18	1. Use authoritative server-derived enterprise/user identity plus live session/subject authorization, never request-body identity. The ordinary user cannot choose the upstream endpoint, provider credentials or effective model alias.
    19	2. In a new primary-DB transaction, serialize grant/price changes and lock the user-period account. Enforce a unique `(enterprise, user, requestKey)` across months. Load any existing reservation while locked; run these reducers; atomically persist account, reservation and append-only audit. Version/CAS or row locks must cover dispatch claims, cancellation and settlement as well. Pure reducer tests do **not** prove this concurrency property.
    20	3. Derive request digest from the complete effective request. Enforce input limits with a verified tokenizer/context bound and hard-cap upstream output. Persist the dispatch claim before network I/O. Do not retry an uncertain upstream attempt under the same or an automatically minted new key.
    21	4. Perform network I/O outside the transaction. Normalize the gateway's final usage without inventing zero values for missing counters. Settlement must remain possible after a user is disabled so incurred charges are still recorded; that does not restore permission to dispatch.
    22	5. Unknown/malformed usage must retain the hold and enter reconciliation. No automatic TTL refund. A database failure prevents dispatch; an ambiguous settlement commit is resolved from the durable idempotency record.
    23	6. Shared gateway credentials remain backend-only. Apply controls to all generation entrances, including streaming/non-streaming, retries, tools/agents, public API paths and custom-provider/BYOK bypasses. Browser model hiding is not enforcement.
    24	7. Settlement's non-null `freezeUser` effect MUST set the matching user-scoped policy's `spendingFrozen` in the same transaction, even when settling an expired monthly account. Every reserve/dispatch must load this authoritative user policy, under the same user lock used for settlements. `freezeUser: null` means no action, never unfreeze; a month rollover must not reset `spendingFrozen`. This cross-period transaction is still an unimplemented integration requirement.
    25	8. Admin model grants/prices/budgets need real server-side authorization, atomic audited updates and revision checks. Lowering a limit does not erase spend/holds. A later explicit adjustment is needed to unfreeze an overrun.
    26	9. Pricing may not match the gateway's actual charge: without a documented price/usage contract, describe the result as local tariff accounting, not reconciled upstream billing. A platform monthly budget is not a hard spending limit on the shared gateway key against all other clients.
    27	
    28	Tests deliberately use synthetic rates and exercise deterministic state transitions. They do not call a paid model or prove durable reservations, crash recovery, app integration or product UAT.
