+    const [row] = await fixture.db.select().from(youlinIdentityOutbox);
+    expect(row).toMatchObject({
+      attempts: 2,
+      deliveredAt: null,
+      leaseExpiresAt: null,
+      leaseToken: null,
+      status: 'dead',
